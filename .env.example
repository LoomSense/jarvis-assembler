# Server secrets. Copy to .env (git-ignored): `make env` does it and generates DEMO_KEY.
# Never put these in client code or in git (PLAN §8.2).

# Google AI Studio key, billing Tier 1 (SET-01). Used by the pipeline, the perception loop and the Live token.
GEMINI_API_KEY=

# fal image-to-3D, only for odd non-board parts (optional for the demo guide).
FAL_KEY=

# boxd SDK key. The boxd CLI itself reads BOXD_TOKEN, or uses `boxd auth login`.
BOXD_API_KEY=

# Shared demo password. Every /api, /files and /ws route needs it: `X-Demo-Key` header or `?key=`.
DEMO_KEY=

# --- build agent (PLAN D20) ---
# The build agent runs on the Claude Agent SDK. It uses ANTHROPIC_API_KEY if set, otherwise this machine's
# Claude Code login. Never put the key in client code or in git.
# ANTHROPIC_API_KEY=
# These three are read from the process environment, not from this file: export them before starting the server.
# AGJ_BUILD_AGENT=claude        # turn the agent on; without it known guides use their hand-checked plan
# AGJ_AGENT_MODEL=claude-opus-5-5
# AGJ_AGENT_MAX_USD=8

# --- optional ---
# JOBS_DIR=jobs
# BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
# CORS_ORIGINS=https://your-mirror.vercel.app
# ALLOW_GOLDEN_PLAN=true
# TREG_TOKEN=

# Phase-2 questions per step, written at the end of the refs stage: template (default, no network),
# model (gemini-4-hydrogen writes the visual criteria, one call per step), off.
# AGJ_QUESTIONS=model

# --- phase-2 perception (server/perception) ---
# Vision needs GEMINI_API_KEY. Without it the socket says "vision unavailable" and looks at no frame.
# PERCEPTION_SIMULATE=true     # answers come from a debug script, not from Decision 1; every message carries sim:true
# PERCEPTION_LOGS=true         # write jobs/<id>/perception/<session>/{frames,events,hands}.jsonl
# Overrides for the numbers in server/perception/config.py, as one JSON object in single quotes. `watcher`
# overrides the measured ones in pipeline/perception/logic.py (Config):
# PERCEPTION_TUNING='{"max_in_flight": 8, "watcher": {"done_yes": 0.5}, "headset": {"step_complete": [9, 10]}}'
