{
  "name": "assembly-guide-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Assembly guide client: the guide page for phone and laptop (one full-screen 3D scene that plays a flat-pack guide action by action), and two Quest headset experiences (?mode=xr and ?mode=headset)",
  "scripts": {
    "dev": "vite",
    "dev:standalone": "AGJ_STANDALONE=1 vite",
    "dev:https": "HTTPS=1 vite",
    "quest": "adb reverse tcp:5173 tcp:5173 && echo 'Quest Browser: http://localhost:5173/?mode=xr'",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@iwer/devui": "2.8.0",
    "@iwer/sem": "2.8.0",
    "@types/node": "^22.20.5",
    "@types/three": "0.187.0",
    "@types/webxr": "0.5.24",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "iwer": "2.8.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
